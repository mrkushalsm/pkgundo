[Unit]
Description=pkgundo tracked-app monitoring daemon
After=local-fs.target
ConditionPathExists=/usr/bin/pkgundo

[Service]
Type=simple
ExecStart=/usr/bin/pkgundo daemon
User=root
Restart=on-failure
RestartSec=2s
RuntimeDirectory=pkgundo
RuntimeDirectoryMode=0755
StateDirectory=pkgundo
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
